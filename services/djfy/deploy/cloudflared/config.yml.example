# deploy.sh fills in the tunnel id (from `cloudflared tunnel create djfy`).
# The credentials JSON goes next to it and must never be committed.
tunnel: <TUNNEL-ID>
credentials-file: /etc/cloudflared/<TUNNEL-ID>.json

ingress:
  - hostname: djfy.ol1n.com
    service: http://djfy-relay:8097
    originRequest:
      connectTimeout: 30s
      keepAliveTimeout: 300s   # SSE streams
  - service: http_status:404
